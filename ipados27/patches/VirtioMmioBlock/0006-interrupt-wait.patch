+// The window's interrupt, in the primary interrupt context (the line is level): the status is acknowledged here and every
+// reader asleep for the device is woken, each to collect and look for its own slot.
+void NativeVirtioBlock::interrupt(void *context)
+{
+  const uintptr_t at = reinterpret_cast<uintptr_t>(context);
+  NativeVirtioBlock *self = at < 8 ? interruptOwners[at] : nullptr;
+  __atomic_fetch_add(&native_virtio_irq_waits[4], 1, __ATOMIC_RELAXED);
+  if (!self) return;
+  const uint32_t status = self->read32(0x60) & 3;
+  if (status) self->write32(0x64, status);
+  thread_wakeup_prim(reinterpret_cast<event_t>(&self->sleepers), FALSE, THREAD_AWAKENED);
+}
