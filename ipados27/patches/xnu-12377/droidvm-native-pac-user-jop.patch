+++ b/osfmk/vm/vm_shared_region.c
@@ -1230,6 +1230,24 @@
 	return false;
 }
 
+#if defined(__arm64__)
+#include <pexpert/arm64/board_config.h>
+#endif
+#if HAS_NATIVE_PAC
+/*
+ * The pager key of the auth mappings of a task with user JOP disabled (task_sign_pointers): its
+ * EL0 runs with the A and D keys off (locore.s), so the auth pointers of its slid pages stay
+ * unsigned, as its own are. Every other pager signs, whatever its key: the architectural keys are
+ * one set for the kernel and every process (native_pac_keys), the shared region's first slide
+ * pager has key 0, and a task's jop_pid only picks its pager.
+ */
+#define SHARED_REGION_UNSIGNED_JOP_KEY   0x6e6f2d6a6f702d00ULL   /* an arbitrary constant no random key takes in practice */
+#define SHARED_REGION_SIGNS_FOR(jop_key) ((jop_key) != SHARED_REGION_UNSIGNED_JOP_KEY)
+#else
+#define SHARED_REGION_UNSIGNED_JOP_KEY   0
+#define SHARED_REGION_SIGNS_FOR(jop_key) 1
+#endif /* HAS_NATIVE_PAC */
+
 #if __has_feature(ptrauth_calls)
 
 /*
@@ -1302,7 +1320,7 @@
 		 */
 		object = si->si_slide_object;
 		sr_pager = shared_region_pager_match(object, si->si_start, si,
-		    use_ptr_auth ? task->jop_pid : 0);
+		    use_ptr_auth ? task->jop_pid : SHARED_REGION_UNSIGNED_JOP_KEY);
 		if (sr_pager == MEMORY_OBJECT_NULL) {
 			printf("%s(): shared_region_pager_match() failed\n", __func__);
 			kr = KERN_FAILURE;
