diff --git a/pexpert/arm/pe_serial.c b/pexpert/arm/pe_serial.c
index 032d9e0..4a283ec 100644
--- a/pexpert/arm/pe_serial.c
+++ b/pexpert/arm/pe_serial.c
@@ -733,6 +733,108 @@ pl011_uart_setup(const DeviceTreeNode *const devicetree_node)
 
 /*****************************************************************************/
 
+#ifdef NS16550_UART
+
+/*
+ * DroidVM: a 16550 UART ("ns16550a"), as crosvm emulates its four COM ports: byte-wide registers one byte apart (no
+ * reg-shift), polled, no FIFO interrupts. Each access is one ldrb/strb on a plain base register, which a hypervisor's MMIO
+ * trap decodes (no writeback, no pair). The devicetree node's reg is relative to the SoC base, as the other drivers'; a
+ * COM port below that base gives an offset that wraps, and the sum is its address.
+ */
+static vm_offset_t ns16550_base = 0;
+
+#define NS16550_RBR_THR 0x0     /* receive buffer / transmit holding (DLAB 0), divisor latch low (DLAB 1) */
+#define NS16550_IER     0x1     /* interrupt enable (DLAB 0), divisor latch high (DLAB 1) */
+#define NS16550_FCR     0x2     /* FIFO control (write) */
+#define NS16550_LCR     0x3     /* line control */
+#define NS16550_MCR     0x4     /* modem control */
+#define NS16550_LSR     0x5     /* line status */
+#define NS16550_LSR_DR   0x01   /* a received byte is waiting */
+#define NS16550_LSR_THRE 0x20   /* the transmit holding register is empty */
+
+static uint8_t
+ns16550_read(unsigned int offset)
+{
+	uint32_t value;
+	__asm__ volatile ("ldrb %w0, [%1]" : "=r"(value) : "r"(ns16550_base + offset) : "memory");
+	return (uint8_t)value;
+}
+
+static void
+ns16550_write(unsigned int offset, uint8_t value)
+{
+	__asm__ volatile ("strb %w0, [%1]" :: "r"((uint32_t)value), "r"(ns16550_base + offset) : "memory");
+}
+
+static unsigned int
+ns16550_uart_transmit_ready(void)
+{
+	return (ns16550_read(NS16550_LSR) & NS16550_LSR_THRE) != 0;
+}
+
+static void
+ns16550_uart_transmit_data(uint8_t c)
+{
+	ns16550_write(NS16550_RBR_THR, c);
+}
+
+static unsigned int
+ns16550_uart_receive_ready(void)
+{
+	return (ns16550_read(NS16550_LSR) & NS16550_LSR_DR) != 0;
+}
+
+static uint8_t
+ns16550_uart_receive_data(void)
+{
+	return ns16550_read(NS16550_RBR_THR);
+}
+
+static void
+ns16550_uart_init(void)
+{
+	ns16550_write(NS16550_IER, 0x00);        // no interrupts: polled
+	ns16550_write(NS16550_LCR, 0x80);        // DLAB: the divisor latch
+	ns16550_write(NS16550_RBR_THR, 0x01);    // 115200 baud from the 1.8432 MHz clock
+	ns16550_write(NS16550_IER, 0x00);
+	ns16550_write(NS16550_LCR, 0x03);        // 8-N-1, DLAB off
+	ns16550_write(NS16550_FCR, 0x07);        // FIFOs on and cleared
+	ns16550_write(NS16550_MCR, 0x03);        // DTR and RTS, no loopback
+}
+
+SECURITY_READ_ONLY_LATE(static struct pe_serial_functions) ns16550_uart_serial_functions =
+{
+	.init = ns16550_uart_init,
+	.transmit_ready = ns16550_uart_transmit_ready,
+	.transmit_data = ns16550_uart_transmit_data,
+	.receive_ready = ns16550_uart_receive_ready,
+	.receive_data = ns16550_uart_receive_data,
+	.device = SERIAL_NS16550_UART
+};
+
+static void
+ns16550_uart_setup(const DeviceTreeNode *const devicetree_node)
+{
+	const struct {
+		uint64_t block_offset;
+		uint64_t block_size;
+	} *reg;
+	unsigned int reg_size;
+	if (SecureDTGetProperty(devicetree_node, "reg", (const void **)&reg, &reg_size) != kSuccess) {
+		panic("Unable to find the 'reg' property on the 16550 UART devicetree node");
+	}
+	assert(reg_size == sizeof(*reg));
+
+	const vm_offset_t soc_base_phys = pe_arm_get_soc_base_phys();
+	ns16550_base = ml_io_map(soc_base_phys + reg->block_offset, reg->block_size);
+
+	register_serial_functions(&ns16550_uart_serial_functions);
+}
+
+#endif /* NS16550_UART */
+
+/*****************************************************************************/
+
 /**
  * Output @str onto every registered serial interface by polling.
  *
@@ -809,6 +911,9 @@ static const struct {
 #ifdef PL011_UART
 	{ .compatible = "arm,pl011", .setup = pl011_uart_setup },
 #endif // PL011_UART
+#ifdef NS16550_UART
+	{ .compatible = "ns16550a", .setup = ns16550_uart_setup },
+#endif // NS16550_UART
 };
 
 /**
@@ -838,6 +943,14 @@ get_serial_device_phandle(uint32_t * const phandle)
 		assert(defaults_phandle_size == sizeof(*defaults_phandle));
 		*phandle = *defaults_phandle;
 		serial_device_phandle_specified = true;
+	} else if (SecureDTGetProperty(defaults_node, "droidvm,serial-device", (const void **)&defaults_phandle,
+	    &defaults_phandle_size) == kSuccess && defaults_phandle_size == sizeof(*defaults_phandle)) {
+		/*
+		 * DroidVM: DarwinBoot names the VM's console UART under a name of its own, which only a kernel with these
+		 * drivers reads; a serial-device naming a UART a kernel has no driver for panics below.
+		 */
+		*phandle = *defaults_phandle;
+		serial_device_phandle_specified = true;
 	}
 
 	// Allow people to manually specify a serial device phandle via bootarg.
