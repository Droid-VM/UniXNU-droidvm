 /*
+ * DroidVM: the board's scheduler trace (DroidVMSchedTrace.c), NULL until the board installs it: every context switch, after the
+ * perfcontrol callout (the thread switched from still holds its wait event and block hint), and every wakeup with its waker.
+ */
+extern void (*volatile droidvm_sched_trace_switch)(thread_t old, thread_t new, uint64_t timestamp);
+extern void (*volatile droidvm_sched_trace_wake)(thread_t thread, thread_t waker);
+void (*volatile droidvm_sched_trace_switch)(thread_t old, thread_t new, uint64_t timestamp);
+void (*volatile droidvm_sched_trace_wake)(thread_t thread, thread_t waker);
+
+/*
  *	Routine:	thread_go
  *	Purpose:
  *		Unblock and dispatch thread.
@@ -1065,6 +1074,9 @@
