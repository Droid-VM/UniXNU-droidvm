diff --git a/osfmk/arm64/locore.s b/osfmk/arm64/locore.s
--- a/osfmk/arm64/locore.s
+++ b/osfmk/arm64/locore.s
@@ -914,14 +914,14 @@
 #if HAS_NATIVE_PAC
 	/*
 	 * A thread of a task with user JOP disabled (an arm64 executable, not arm64e) ran EL0 with
-	 * the IA, DA and DB keys off (see the exception return): on again before the kernel
-	 * authenticates anything, the user PCB below first.
+	 * every key off, IB too (see the exception return): on again before the kernel
+	 * authenticates anything, the user PCB below first, and before its first return address.
 	 */
 	mrs		x0, TPIDR_EL1
 	ldr		w1, [x0, TH_ARM_MACHINE_FLAGS]
 	tbz		w1, ARM_MACHINE_THREAD_DISABLE_USER_JOP_SHIFT, 1f
 	mrs		x0, SCTLR_EL1
-	MOV64	x1, (SCTLR_PACIA_ENABLED | SCTLR_PACDA_ENABLED | SCTLR_PACDB_ENABLED)
+	MOV64	x1, (SCTLR_PACIA_ENABLED | SCTLR_PACIB_ENABLED | SCTLR_PACDA_ENABLED | SCTLR_PACDB_ENABLED)
 	orr		x0, x0, x1
 	msr		SCTLR_EL1, x0
 	isb		sy
@@ -2094,7 +2094,12 @@
 	 * EL0 and EL1 here (native_pac_keys), and the task's arm64 code signs nothing, so the
 	 * arm64e code of the shared cache it runs must authenticate its unsigned pointers (an
 	 * Objective-C class's ro data, a block's invoke) as a disabled key does: unchanged. IB, the
-	 * return address key, stays on. Nothing below authenticates with the keys turned off.
+	 * return address key, goes off as well (the process runs "keys off", as dyld's name for its
+	 * arm64e grading says): libunwind authenticates every frame's return address with it, and
+	 * the arm64 frames' are unsigned, so with IB on any C++ exception thrown through arm64 code
+	 * died in the unwinder (EXC_ARM_PAC_FAIL; GFXBench's command line parser at every
+	 * unknown test). The kernel signs nothing for such a thread (its thread state is
+	 * NO_PTRAUTH). Nothing below authenticates or returns with the keys turned off.
 	 */
 	mrs		x2, SPSR_EL1
 	and		x2, x2, #(PSR64_MODE_EL_MASK)
@@ -2104,7 +2109,7 @@
 	ldr		w3, [x2, TH_ARM_MACHINE_FLAGS]
 	tbz		w3, ARM_MACHINE_THREAD_DISABLE_USER_JOP_SHIFT, 1f
 	mrs		x2, SCTLR_EL1
-	MOV64	x3, (SCTLR_PACIA_ENABLED | SCTLR_PACDA_ENABLED | SCTLR_PACDB_ENABLED)
+	MOV64	x3, (SCTLR_PACIA_ENABLED | SCTLR_PACIB_ENABLED | SCTLR_PACDA_ENABLED | SCTLR_PACDB_ENABLED)
 	bic		x2, x2, x3
 	msr		SCTLR_EL1, x2
 	isb		sy
