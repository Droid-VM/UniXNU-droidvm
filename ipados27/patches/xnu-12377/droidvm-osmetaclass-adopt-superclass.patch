 /*********************************************************************
+* DroidVM (droidvm-osmetaclass-adopt-superclass.patch): make the class
+* className, of no instance yet, a subclass of superName, where superName
+* itself descends from its present superclass: a class this kernel defines
+* then stands in the class chain where an original family's subclass stands.
+* The sandbox matches a user client by its class chain (the profiles'
+* iokit-user-client-class), and the original profiles name the GPU family's
+* base user client (IOGPUDeviceUserClient), which Apple's AGXDeviceUserClient
+* derives from; the native GPU driver's user client is an IOUserClient as C++
+* sees it, and stays one: its new superclass descends from IOUserClient. Only
+* with no instance, as an instance counts itself up its chain.
 *********************************************************************/
+bool
+OSMetaClassAdoptSuperclass(const char * className, const char * superName)
+{
+	const OSSymbol * name = OSSymbol::withCString(className);
+	const OSSymbol * adoptedName = OSSymbol::withCString(superName);
+	bool adopted = false;
+
+	IOLockLock(sAllClassesLock);
+	OSMetaClass * meta = (sAllClassesDict && name) ? (OSMetaClass *) sAllClassesDict->getObject(name) : NULL;
+	const OSMetaClass * parent = (sAllClassesDict && adoptedName) ? (const OSMetaClass *) sAllClassesDict->getObject(adoptedName) : NULL;
+	if (meta && parent && parent != meta && meta->instanceCount == 0) {
+		const OSMetaClass * walk = parent;
+		while (walk && walk != meta && walk != meta->superClassLink) {
+			walk = walk->superClassLink;
+		}
+		if (walk && walk == meta->superClassLink) {
+			meta->superClassLink = parent;
+			adopted = true;
+		}
+	}
+	IOLockUnlock(sAllClassesLock);
+
+	OSSafeReleaseNULL(name);
+	OSSafeReleaseNULL(adoptedName);
+	return adopted;
+}
+
+/*********************************************************************
+*********************************************************************/
 const OSMetaClass *
 OSMetaClass::copyMetaClassWithName(const OSSymbol * name)
 {
