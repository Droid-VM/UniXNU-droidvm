 /*
+ * DroidVM: the timebase is the architected counter scaled by num/den (pe_identify_machine.c, droidvm-timebase-hz): 24 MHz over a
+ * 19.2 MHz counter is 5/4. Every kernel read of the counter goes through timebase_from_counter, a decrementer value is converted
+ * back to counter ticks, and userspace takes the timebase through the mach_absolute_time trap (user_timebase_type).
+ */
+uint32_t ml_timebase_scale_num = 1, ml_timebase_scale_den = 1;
+
+static inline bool
+timebase_scaled(void)
+{
+	return ml_timebase_scale_num != ml_timebase_scale_den;
+}
+
+static inline uint64_t
+timebase_from_counter(uint64_t counter)
+{
+	const uint64_t num = ml_timebase_scale_num, den = ml_timebase_scale_den;
+
+	if (__probable(num == den)) {
+		return counter;
+	}
+	return counter / den * num + counter % den * num / den;
+}
+
+/*
  * Assumes fiq, irq disabled.
  */
 void
 ml_set_decrementer(uint32_t dec_value)
 {
 	cpu_data_t      *cdp = getCpuDatap();
+	uint64_t        counter_value = dec_value;
 
 	assert(ml_get_interrupts_enabled() == FALSE);
 	cdp->cpu_decrementer = dec_value;
 
+	if (timebase_scaled()) {
+		/* Counter ticks, rounded up: the timer fires at the deadline or just after it, never before. */
+		counter_value = (counter_value * ml_timebase_scale_den + ml_timebase_scale_num - 1) / ml_timebase_scale_num;
+		if (counter_value > 0x7fffffff) {
+			counter_value = 0x7fffffff;
+		}
+	}
+
 	if (cdp->cpu_set_decrementer_func) {
-		cdp->cpu_set_decrementer_func(dec_value);
+		cdp->cpu_set_decrementer_func((uint32_t)counter_value);
 	} else {
-		__builtin_arm_wsr64(KERNEL_CNTV_TVAL_EL0, (uint64_t)dec_value);
+		__builtin_arm_wsr64(KERNEL_CNTV_TVAL_EL0, counter_value);
 	}
 }
 
